{
	"name": "support-e2e",
	"version": "1.0.0",
	"license": "Apache-2.0",
	"scripts": {
		"prettier-check": "prettier --check ./",
		"prettier-fix": "prettier --write ./",
		"test-smoke": "playwright test --project=smoke --config=playwright.config.ts --workers 50%",
		"test-smoke-ui": "playwright test --project=smoke --config=playwright.config.ts --ui",
		"test-smoke-code": "playwright test --project=smoke --config=playwright.code.config.ts --workers 50%",
		"test-smoke-ui-code": "playwright test --project=smoke --config=playwright.code.config.ts --ui",
		"test-smoke-dev": "playwright test --project=smoke --config=playwright.dev.config.ts --workers 50%",
		"test-smoke-ui-dev": "playwright test --project=smoke --config=playwright.dev.config.ts --ui",
		"test-cron": "playwright test --project=cron --config=playwright.config.ts --workers 50%",
		"test-cron-ui": "playwright test --project=cron --config=playwright.config.ts --ui",
		"test-cron-code": "playwright test --project=cron --config=playwright.code.config.ts --workers 50%",
		"test-cron-ui-code": "playwright test --project=cron --config=playwright.code.config.ts --ui",
		"test-cron-dev": "playwright test --project=cron --config=playwright.dev.config.ts --workers 50%",
		"show-report": "playwright show-report --host 0.0.0.0 --port 9500",
		"lint": "eslint ./tests/**/*.ts",
		"build": "tsc --noEmit"
	},
	"dependencies": {
		"@playwright/test": "1.62.1",
		"nanoid": "3.3.18"
	},
	"devDependencies": {
		"@types/node": "22.15.29",
		"dotenv": "17.2.2",
		"husky": "9.1.7",
		"lint-staged": "15.5.2",
		"typescript": "5.8.3"
	},
	"lint-staged": {
		"*.ts": [
			"prettier --write",
			"git add"
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	}
}
